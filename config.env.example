# Copy this file to config.env and adjust it for the local machine.

PYTHON_BIN=/path/to/python
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=/path/to/bge-m3
EMBEDDING_DEVICE=cpu
MEMUA_HF_CACHE_DIR=

# Optional external model used by Stage 1. Keep the real key in the shell
# environment, never in this file or source control.
ACTIVEEVO_STRONG_MODEL=deepseek-reasoner
ACTIVEEVO_STRONG_MODEL_URL=https://api.deepseek.com/v1/chat/completions
# export ACTIVEEVO_STRONG_MODEL_API_KEY=...

LEVELS="1 2 3 4"
STAGE2_CONCURRENCY=64
STAGE2_DSD_CONCURRENCY=32
STAGE2_GENERATION_CONCURRENCY=8
STAGE2_CANDIDATE_CONCURRENCY=16
STAGE2_VALIDATION_SEED=42
BATCH_SIZE=8
MAX_TRIALS=10
TIMEOUT=900

TEST_LEVEL=dpo_level2
EVAL_CONCURRENCY=32
THRESHOLD=0.55
TOP_K=5
ANSWER_MAX_TOKENS=8192

MEMORY_DIR=memory/v3
LOG_DIR=logs
