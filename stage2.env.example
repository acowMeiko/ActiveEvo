# Copy this file to stage2.env and fill the two keys locally. stage2.env is
# ignored by Git; never commit or paste it into logs.

export ACTIVEEVO_GENERATOR_API_KEY='replace-with-deepseek-key'
export ACTIVEEVO_GENERATOR_URL='https://api.deepseek.com/v1/chat/completions'
export ACTIVEEVO_GENERATOR_MODEL='deepseek-v4-pro'

export ACTIVEEVO_AUDITOR_API_KEY='replace-with-moonshot-key'
export ACTIVEEVO_AUDITOR_URL='https://api.moonshot.cn/v1/chat/completions'
export ACTIVEEVO_AUDITOR_URLS='https://api.moonshot.cn/v1/chat/completions'
export ACTIVEEVO_AUDITOR_MODEL='kimi-k2.6'
