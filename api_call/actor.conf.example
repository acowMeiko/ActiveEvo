# Actor/Solver deployment. Copy to actor.conf on the new machine.
PYTHON_BIN=/path/to/python
HOST=0.0.0.0
DEPLOY_MODEL=llama
DEPLOY_GPU_IDS="0 1 2 3"
DEPLOY_PORT_BASE=8100
DEPLOY_SERVER_SEED=42
DEPLOY_READY_TIMEOUT=600
LLAMA_PATH=/path/to/ActiveEvo/models/actor
QWEN_PATH=/path/to/ActiveEvo/models/actor
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=64
DTYPE=bfloat16
VLLM_EXTRA_ARGS="--enforce-eager --enable-prefix-caching --trust-remote-code"
LOG_DIR=logs/actor
